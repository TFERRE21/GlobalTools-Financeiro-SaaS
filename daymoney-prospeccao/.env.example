NODE_ENV=production
PORT=3015
PUBLIC_BASE_URL=https://SEU-DOMINIO
# Banco EXCLUSIVO da prospecção; não reutilize o banco financeiro.
DATABASE_URL=
POSTGRES_SSL=false
# Gere um segredo aleatório forte (mínimo 32 caracteres).
JWT_SECRET=
# Crie um hash bcrypt para a senha de administrador; não use senha em texto puro.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Resend: configure somente após confirmar o domínio/remetente verificado.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
