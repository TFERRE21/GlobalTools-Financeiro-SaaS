{
  "name": "globaltools-financeiro-saas",
  "version": "1.0.0",
  "private": true,
  "description": "Servidor estático do GlobalTools Financeiro SaaS com robô de prospecção opcional",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "prospect:check": "node --env-file=.env.prospecting prospecting/run.js",
    "prospect:send": "SEND_EMAILS=true node --env-file=.env.prospecting --disable-warning=ExperimentalWarning prospecting/run.js"
  },
  "engines": {
    "node": ">=20"
  }
}
